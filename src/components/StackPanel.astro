---
// Seção Stack: legenda de status e um StackCard por grupo de src/data/stack.json.
import type { CollectionEntry } from 'astro:content';
import { pt } from '../i18n/pt';
import StatusBadge from './StatusBadge.astro';
import TechLogo from './TechLogo.astro';
import Glyph from './Glyph.astro';

interface Props {
  itens: CollectionEntry<'stack'>[];
}

const { itens } = Astro.props;

const ordemStatus = ['profissional', 'projetos', 'estudando', 'próximo'] as const;
const grupos = (Object.keys(pt.stack.grupos) as (keyof typeof pt.stack.grupos)[])
  .map((grupo) => ({
    grupo,
    itens: itens
      .filter((i) => i.data.grupo === grupo)
      .sort((a, b) => ordemStatus.indexOf(a.data.status) - ordemStatus.indexOf(b.data.status)),
  }))
  .filter((g) => g.itens.length > 0);
---

<div>
	<ul class="flex flex-wrap gap-2" aria-label={pt.legenda}>
		{
			ordemStatus.map((s) => (
				<li>
					<StatusBadge status={s} />
				</li>
			))
		}
	</ul>
	<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{
			grupos.map(({ grupo, itens }) => (
				<section class="pp-card pp-stack" aria-labelledby={`stack-${grupo}`}>
					<h3 id={`stack-${grupo}`} class="pp-stack__title">
						{pt.stack.grupos[grupo]}
					</h3>
					<ul class="pp-stack__list">
						{itens.map(({ data }) => (
							<li class="pp-stack__item">
								<span class="pp-stack__tile">
									<TechLogo tech={data.nome} size={20} decorative />
								</span>
								<span class="pp-stack__body">
									<span class="pp-stack__name">
										{data.nome}
										{data.foco && (
											<span class="pp-stack__foco">
												<Glyph name="star" size={11} /> {pt.stack.foco}
											</span>
										)}
									</span>
									<StatusBadge status={data.status} />
								</span>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</div>
