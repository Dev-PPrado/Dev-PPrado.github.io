---
import type { CollectionEntry } from 'astro:content';
import { pt } from '../i18n/pt';
import StatusBadge from './StatusBadge.astro';

interface Props {
  itens: CollectionEntry<'stack'>[];
}

const { itens } = Astro.props;

const ordemStatus = ['profissional', 'projetos', 'estudando', 'próximo'] as const;
const grupos = (Object.keys(pt.stack.grupos) as (keyof typeof pt.stack.grupos)[])
  .map((grupo) => ({
    grupo,
    itens: itens
      .filter((i) => i.data.grupo === grupo)
      .sort((a, b) => ordemStatus.indexOf(a.data.status) - ordemStatus.indexOf(b.data.status)),
  }))
  .filter((g) => g.itens.length > 0);
---

<div>
	<ul class="flex flex-wrap gap-2" aria-label="Legenda">
		{ordemStatus.map((s) => <li><StatusBadge status={s} label={pt.stack.status[s]} /></li>)}
	</ul>
	<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
		{grupos.map(({ grupo, itens }) => (
			<div class="rounded-lg border border-slate-200 p-4 dark:border-slate-800">
				<h3 class="text-sm font-semibold text-slate-900 dark:text-white">{pt.stack.grupos[grupo]}</h3>
				<ul class="mt-3 space-y-2">
					{itens.map(({ data }) => (
						<li class="flex items-center justify-between gap-3 text-sm">
							<span>
								{data.nome}
								{data.foco && (
									<span class="ml-1 text-xs font-semibold text-sky-700 dark:text-sky-300">★ {pt.stack.foco}</span>
								)}
							</span>
							<StatusBadge status={data.status} label={pt.stack.status[data.status]} />
						</li>
					))}
				</ul>
			</div>
		))}
	</div>
</div>
