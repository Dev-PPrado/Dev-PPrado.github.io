---
import type { CollectionEntry } from 'astro:content';
import { pt } from '../i18n/pt';
import { formatMes } from '../lib/format';
import StatusBadge from './StatusBadge.astro';

type Etapa = CollectionEntry<'roadmap'>['data'];

interface Props {
  etapas: CollectionEntry<'roadmap'>[];
}

// Concluídas e em andamento em ordem cronológica; planejadas no fim, na ordem do JSON.
const ordemStatus = ['concluído', 'em andamento', 'planejado'] as const;
const chave = (e: Etapa) => e.fim ?? e.inicio ?? '9999-12';
const etapas = [...Astro.props.etapas].sort(
  (a, b) =>
    ordemStatus.indexOf(a.data.status) - ordemStatus.indexOf(b.data.status) ||
    chave(a.data).localeCompare(chave(b.data)),
);

function periodo(e: Etapa): string {
  if (e.inicio && e.fim) return `${formatMes(e.inicio)} – ${formatMes(e.fim)}`;
  if (e.fim) return formatMes(e.fim);
  if (e.inicio) return `desde ${formatMes(e.inicio)}`;
  return pt.evolucao.semData;
}

const corPonto = {
  concluído: 'bg-emerald-600',
  'em andamento': 'bg-amber-500',
  planejado: 'bg-slate-400',
} as const;
---

<ol class="relative space-y-8 border-l border-slate-200 pl-6 dark:border-slate-800">
	{etapas.map(({ data }) => (
		<li class="relative">
			<span
				aria-hidden="true"
				class:list={[
					'absolute top-1.5 -left-[1.95rem] h-3 w-3 rounded-full ring-4 ring-white dark:ring-slate-950',
					corPonto[data.status],
				]}
			/>
			<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
				<p class="text-xs text-slate-500 dark:text-slate-400">{periodo(data)}</p>
				<StatusBadge status={data.status} label={pt.evolucao.status[data.status]} />
			</div>
			<h3 class="mt-1 font-semibold text-slate-900 dark:text-white">{data.titulo}</h3>
			{data.itens.length > 0 && (
				<p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{data.itens.join(' · ')}</p>
			)}
			{data.link && (
				<a
					href={data.link}
					class="mt-2 inline-block rounded text-sm font-medium text-sky-700 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-sky-600 dark:text-sky-300"
				>
					{pt.evolucao.certificado}<span class="sr-only">: {data.titulo}</span>
				</a>
			)}
		</li>
	))}
</ol>
