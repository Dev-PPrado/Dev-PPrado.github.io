---
import type { CollectionEntry } from 'astro:content';
import { pt } from '../i18n/pt';
import { formatMes } from '../lib/format';
import { resolveTech } from '../lib/tech';
import StatusBadge from './StatusBadge.astro';
import TechTag from './TechTag.astro';
import Button from './Button.astro';

type Etapa = CollectionEntry<'roadmap'>['data'];

interface Props {
  etapas: CollectionEntry<'roadmap'>[];
}

// Concluídas e em andamento em ordem cronológica; planejadas no fim, na ordem do JSON.
const ordemStatus = ['concluído', 'em andamento', 'planejado'] as const;
const chave = (e: Etapa) => e.fim ?? e.inicio ?? '9999-12';
const etapas = [...Astro.props.etapas].sort(
  (a, b) =>
    ordemStatus.indexOf(a.data.status) - ordemStatus.indexOf(b.data.status) ||
    chave(a.data).localeCompare(chave(b.data)),
);

function periodo(e: Etapa): string {
  if (e.inicio && e.fim) return `${formatMes(e.inicio)} – ${formatMes(e.fim)}`;
  if (e.fim) return formatMes(e.fim);
  if (e.inicio) return `desde ${formatMes(e.inicio)}`;
  return pt.evolucao.semData;
}

const ponto = { concluído: 'success', 'em andamento': 'warn', planejado: 'neutral' } as const;
// Na linha do tempo só aparecem logos reais (Simple Icons), sem monogramas.
const temLogo = (t: string) => resolveTech(t)?.icone !== undefined;
---

<ol class="pp-timeline">
	{
		etapas.map(({ data }) => (
			<li class="pp-timeline__item">
				<span class:list={['pp-timeline__dot', `pp-dot--${ponto[data.status]}`]} aria-hidden="true" />
				<div class="pp-timeline__meta">
					<span class="pp-mono-sm">{periodo(data)}</span>
					<StatusBadge status={data.status} />
				</div>
				<h3 class="pp-timeline__title">{data.titulo}</h3>
				{data.itens.length > 0 && (
					<ul class="pp-taglist pp-taglist--tight" aria-label={pt.projetos.stack}>
						{data.itens.map((t) => (
							<li>
								<TechTag tech={t} logo={temLogo(t)} />
							</li>
						))}
					</ul>
				)}
				{data.link && (
					<div class="pp-timeline__link">
						<Button href={data.link} variant="link">
							{pt.evolucao.certificado}
							<span class="pp-sr">: {data.titulo}</span>
						</Button>
					</div>
				)}
			</li>
		))
	}
</ol>
