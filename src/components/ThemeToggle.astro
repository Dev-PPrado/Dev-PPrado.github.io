---
// Alterna claro/escuro: classe .dark e data-theme no <html>, preferência em localStorage.tema.
// O script inline do <head> do Layout aplica o tema antes da pintura.
import { pt } from '../i18n/pt';
import Glyph from './Glyph.astro';
---

<button type="button" id="tema-toggle" class="pp-icon-btn" aria-label={pt.theme.toggle} title={pt.theme.toggle}>
	<Glyph name="moon" size={20} class="dark:hidden" />
	<Glyph name="sun" size={20} class="hidden dark:block" />
</button>

<script>
	const botao = document.getElementById('tema-toggle');
	const atualizarAria = () =>
		botao?.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')));
	atualizarAria();
	botao?.addEventListener('click', () => {
		const raiz = document.documentElement;
		const escuro = raiz.classList.toggle('dark');
		raiz.setAttribute('data-theme', escuro ? 'dark' : 'light');
		try {
			localStorage.setItem('tema', escuro ? 'escuro' : 'claro');
		} catch {}
		atualizarAria();
	});
</script>
