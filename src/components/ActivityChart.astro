---
// Seção Atividade, gerada no build a partir de src/data/github_stats.json:
// StatTiles, gráfico de colunas em SVG puro (tooltip = <title> nativo), tabela alternativa e LanguageBars.
import type { GithubStats } from '../lib/github-stats';
import { pt } from '../i18n/pt';
import { formatMes } from '../lib/format';
import StatTile from './StatTile.astro';
import LanguageBars from './LanguageBars.astro';

interface Props {
  stats: GithubStats;
}

const { stats } = Astro.props;
const t = pt.atividade;
const meses = stats.commits_por_mes;
const numero = new Intl.NumberFormat(pt.locale, { maximumFractionDigits: 1 });

// Geometria do SVG (unidades do viewBox).
const W = 400;
const H = 200;
const m = { top: 18, right: 4, bottom: 34, left: 26 };
const plotW = W - m.left - m.right;
const plotH = H - m.top - m.bottom;
const banda = plotW / Math.max(meses.length, 1);
const larguraBarra = Math.min(16, banda * 0.6);

// Eixo Y com passos "redondos" (1, 2, 5, 10, 20, 50...), cerca de 4 divisões.
const maximo = Math.max(1, ...meses.map((x) => x.commits));
const passo = [1, 2, 5, 10, 20, 50, 100, 200, 500, 1000].find((p) => maximo / p <= 4) ?? 1000;
const topo = Math.ceil(maximo / passo) * passo;
const ticks = Array.from({ length: topo / passo + 1 }, (_, i) => i * passo);
const y = (v: number) => m.top + plotH - (v / topo) * plotH;
const base = y(0);

// Coluna com topo arredondado (raio 4) e base reta.
function coluna(x: number, altura: number): string {
  const r = Math.min(4, altura, larguraBarra / 2);
  const yt = base - altura;
  return `M${x},${base}V${yt + r}Q${x},${yt} ${x + r},${yt}H${x + larguraBarra - r}Q${x + larguraBarra},${yt} ${x + larguraBarra},${yt + r}V${base}Z`;
}

const curto = new Intl.DateTimeFormat(pt.locale, { month: 'short', timeZone: 'UTC' });
const colunas = meses.map((item, i) => {
  const [ano, mes] = item.mes.split('-').map(Number);
  const x0 = m.left + i * banda;
  return {
    ...item,
    x0,
    xBarra: x0 + (banda - larguraBarra) / 2,
    altura: base - y(item.commits),
    rotulo: curto.format(new Date(Date.UTC(ano, mes - 1, 1))).replace('.', ''),
    ano: i === 0 || mes === 1 ? String(ano) : '',
    extenso: formatMes(item.mes),
  };
});

const pico = colunas.reduce((a, b) => (b.commits > a.commits ? b : a), colunas[0]);
const resumo =
  colunas.length > 0
    ? t.resumoGrafico(colunas[0].extenso, colunas.at(-1)!.extenso, stats.total_commits, pico.extenso, pico.commits)
    : '';

// Linguagens: as 5 maiores e o resto somado em "Outras".
const principais = stats.linguagens.slice(0, 5);
const resto = stats.linguagens.slice(5);
const linguagens = [
  ...principais.map((l) => ({ nome: l.nome, percentual: l.percentual })),
  ...(resto.length
    ? [{ nome: t.outras, percentual: Math.round(resto.reduce((s, l) => s + l.percentual, 0) * 10) / 10 }]
    : []),
];
const principal = stats.linguagens[0];

const atualizado = new Intl.DateTimeFormat(pt.locale, { dateStyle: 'long', timeZone: 'America/Sao_Paulo' }).format(
  new Date(stats.coletado_em),
);
---

<div class="grid gap-4 sm:grid-cols-3">
	<StatTile label={t.commits} value={String(stats.total_commits)} hint={pico && pico.commits > 0 ? t.pico(pico.extenso, pico.commits) : undefined} />
	<StatTile label={t.repositorios} value={String(stats.repositorios)} tech="github" />
	{
		principal && (
			<StatTile label={t.linguagemPrincipal} value={principal.nome} hint={t.doCodigo(numero.format(principal.percentual))} tech={principal.nome} />
		)
	}
</div>

<div class="mt-10 grid gap-10 lg:grid-cols-[3fr_2fr]">
	<figure class="pp-chart max-w-xl">
		<figcaption id="atividade-grafico-titulo" class="pp-chart__title">{t.porMes}</figcaption>
		<svg
			viewBox={`0 0 ${W} ${H}`}
			class="pp-chart__svg"
			role="img"
			aria-labelledby="atividade-grafico-titulo atividade-grafico-resumo"
		>
			<desc id="atividade-grafico-resumo">{resumo}</desc>
			<g class="pp-chart__grid">
				{ticks.map((v) => <line x1={m.left} x2={W - m.right} y1={y(v)} y2={y(v)} />)}
			</g>
			<g class="pp-chart__axis" text-anchor="end">
				{
					ticks.map((v) => (
						<text x={m.left - 6} y={y(v)} dy="0.32em">
							{v}
						</text>
					))
				}
			</g>
			{
				colunas.map((c) => (
					<g class="pp-chart__col">
						<title>{t.tooltip(c.extenso, c.commits)}</title>
						{/* Área de hover do tamanho da banda inteira, maior que a coluna. */}
						<rect x={c.x0} y={m.top} width={banda} height={plotH} class="pp-chart__hit" />
						{c.altura > 0 && <path d={coluna(c.xBarra, c.altura)} class="pp-chart__bar" />}
						{c.commits > 0 && (
							<text x={c.xBarra + larguraBarra / 2} y={base - c.altura - 5} text-anchor="middle" class="pp-chart__value">
								{c.commits}
							</text>
						)}
						<text x={c.x0 + banda / 2} y={base + 14} text-anchor="middle" class="pp-chart__axis-t">
							{c.rotulo}
						</text>
						{c.ano && (
							<text x={c.x0 + banda / 2} y={base + 27} text-anchor="middle" class="pp-chart__axis-t pp-chart__year">
								{c.ano}
							</text>
						)}
					</g>
				))
			}
		</svg>
		<details class="mt-3 text-sm text-ink-muted">
			<summary class="cursor-pointer rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring">
				{t.tabela}
			</summary>
			<table class="mt-2 w-full max-w-xs text-left font-mono text-xs tabular-nums">
				<thead>
					<tr class="border-b border-border">
						<th scope="col" class="py-1 font-medium">{t.mes}</th>
						<th scope="col" class="py-1 text-right font-medium">Commits</th>
					</tr>
				</thead>
				<tbody>
					{
						colunas.map((c) => (
							<tr>
								<td class="py-0.5">{c.extenso}</td>
								<td class="py-0.5 text-right">{c.commits}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</details>
	</figure>

	<LanguageBars title={t.linguagens} items={linguagens} />
</div>

<p class="mt-8 text-sm text-ink-subtle">
	{t.atualizado} <span class="font-mono">{atualizado}</span>.{' '}
	<a
		href={`https://github.com/${stats.usuario}/Dev-PPrado.github.io/blob/main/scripts/collect_github.py`}
		class="rounded-sm font-medium text-accent-ink underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus-ring"
	>
		{t.codigo}
	</a>
</p>
