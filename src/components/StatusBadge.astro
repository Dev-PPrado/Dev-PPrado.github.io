---
// Pílula de status: ponto + palavra (a cor nunca carrega o significado sozinha).
import { pt } from '../i18n/pt';

const tons = {
  profissional: 'success',
  projetos: 'info',
  estudando: 'warn',
  próximo: 'neutral',
  concluído: 'success',
  'em andamento': 'warn',
  'em desenvolvimento': 'info',
  planejado: 'neutral',
  pausado: 'neutral',
} as const;

const rotulos: Record<keyof typeof tons, string> = {
  ...pt.stack.status,
  ...pt.evolucao.status,
  ...pt.projetos.status,
};

export type Status = keyof typeof tons;

interface Props {
  status: Status;
  class?: string;
}

const { status, class: classe } = Astro.props;
---

<span class:list={['pp-badge', `pp-badge--${tons[status]}`, classe]}>
	<span class="pp-badge__dot" aria-hidden="true"></span>{rotulos[status]}
</span>
