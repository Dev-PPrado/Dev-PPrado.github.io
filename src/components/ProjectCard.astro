---
import type { CollectionEntry } from 'astro:content';
import { pt } from '../i18n/pt';
import { formatMes } from '../lib/format';
import { urlProjeto } from '../lib/projetos';
import StatusBadge from './StatusBadge.astro';
import TechTag from './TechTag.astro';
import Button from './Button.astro';

interface Props {
  projeto: CollectionEntry<'projects'>;
}

const { projeto } = Astro.props;
const { data } = projeto;
const url = urlProjeto(projeto);
---

<article class="pp-card pp-card--interactive pp-project h-full">
	<div class="pp-project__meta">
		<span class="pp-mono-sm">{formatMes(data.data)}</span>
		<StatusBadge status={data.status} />
	</div>
	<h3 class="pp-project__title"><a href={url} class="pp-project__link">{data.titulo}</a></h3>
	<p class="pp-project__summary">{data.resumo}</p>
	{
		data.fluxo && (
			<div class="pp-project__flow" role="group" aria-label={pt.projetos.fluxo}>
				{data.fluxo.map((etapa, i) => (
					<>
						{i > 0 && (
							<span class="pp-project__flow-sep" aria-hidden="true">
								→
							</span>
						)}
						<span>{etapa}</span>
					</>
				))}
			</div>
		)
	}
	<dl class="pp-project__dl">
		<div>
			<dt>{pt.projetos.problema}</dt>
			<dd>{data.problema}</dd>
		</div>
		<div>
			<dt>{pt.projetos.solucao}</dt>
			<dd>{data.solucao}</dd>
		</div>
	</dl>
	<ul class="pp-taglist" aria-label={pt.projetos.stack}>
		{
			data.stack.map((tec) => (
				<li>
					<TechTag tech={tec} />
				</li>
			))
		}
	</ul>
	<div class="pp-project__actions">
		<Button href={url} variant="link">
			{pt.projetos.detalhes}<span class="pp-sr">: {data.titulo}</span>
		</Button>
		<Button href={data.repo} variant="ghost" size="sm" tech="github">
			{pt.projetos.repoCurto}<span class="pp-sr">: {data.titulo}</span>
		</Button>
	</div>
</article>
