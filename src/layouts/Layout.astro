---
import '../styles/global.css';
import { pt } from '../i18n/pt';
import ThemeToggle from '../components/ThemeToggle.astro';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  // "article" nas páginas de projeto; o resto do site é "website".
  tipo?: 'website' | 'article';
}

const { title = pt.siteTitle, description = pt.siteDescription, tipo = 'website' } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagem = new URL('/og.png', Astro.site);

const perfil = await getEntry('perfil', 'perfil');

// Nas páginas de /projetos, o item "Projetos" do menu fica marcado como atual.
const atual = Astro.url.pathname.startsWith('/projetos') ? '/#projetos' : undefined;

const nav = [
  { href: '/#projetos', label: pt.nav.projetos },
  { href: '/#stack', label: pt.nav.stack },
  { href: '/#evolucao', label: pt.nav.evolucao },
  { href: '/#atividade', label: pt.nav.atividade },
  { href: '/#sobre', label: pt.nav.sobre },
];
---

<html lang={pt.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<link rel="preload" href="/fonts/IBMPlexSans-Variable.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonica} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
		<meta name="generator" content={Astro.generator} />

		<meta property="og:type" content={tipo} />
		<meta property="og:site_name" content={pt.siteTitle} />
		<meta property="og:locale" content={pt.ogLocale} />
		<meta property="og:url" content={canonica} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imagem} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={pt.ogImagemAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imagem} />
		<script is:inline>
			// Aplica o tema antes da pintura para evitar flash de tema errado.
			(() => {
				let tema = null;
				try { tema = localStorage.getItem('tema'); } catch {}
				const escuro = tema ? tema === 'escuro' : matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.classList.toggle('dark', escuro);
				document.documentElement.setAttribute('data-theme', escuro ? 'dark' : 'light');
			})();
		</script>
	</head>
	<body class="min-h-screen antialiased">
		<a
			href="#conteudo"
			class="sr-only rounded-md bg-accent px-4 py-2 text-on-accent focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[var(--z-skip)]"
		>
			{pt.skipToContent}
		</a>
		<header class="pp-site">
			<div class="pp-site__inner">
				<a href="/" class="pp-site__brand">
					<span class="pp-site__mark" aria-hidden="true"><i></i><i></i><i></i></span>
					{perfil?.data.nome}
				</a>
				<div class="pp-site__right">
					<nav aria-label="Seções" class="pp-site__nav">
						<ul>
							{
								nav.map((item) => (
									<li>
										<a href={item.href} aria-current={item.href === atual ? 'location' : undefined}>
											{item.label}
										</a>
									</li>
								))
							}
						</ul>
					</nav>
					<ThemeToggle />
				</div>
			</div>
		</header>
		<main id="conteudo">
			<slot />
		</main>
		<footer class="border-t border-border">
			<p class="mx-auto max-w-[var(--content-max)] px-4 py-6 text-sm text-ink-subtle">{pt.rodape}</p>
		</footer>
	</body>
</html>
